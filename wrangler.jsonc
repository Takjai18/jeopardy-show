{
  "name": "jeopardy-show",
  "account_id": "db0374b37171e14e52b085a4b4f0d1dc",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "JEOPARDY_ROOM", "class_name": "JeopardyRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JeopardyRoom"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
